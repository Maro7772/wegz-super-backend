# ===== Server =====
NODE_ENV=production
PORT=3000

# ===== DB =====
# على سيرفر Plesk (نفس سيرفر SuperBackSystego) MongoDB غالبًا على 32768:
# MONGO_URI=mongodb://user:pass@127.0.0.1:32768/SuperWegz?authSource=admin
MONGO_URI=mongodb://user:pass@host:27017/super_wegz?authSource=admin

# ===== JWT =====
JWT_SECRET=change_me_long_random_string
JWT_EXPIRES_IN=1d

# ===== Super Admin (root) =====
SUPER_ADMIN_EMAIL=admin@wegz.org
SUPER_ADMIN_PASSWORD=ChangeMe@123
SUPER_ADMIN_NAME=Super Admin

# ===== Plesk =====
PLESK_HOST=your-plesk-host
PLESK_PORT=8443
PLESK_API_KEY=
PLESK_PARENT_DOMAIN=wegz.org
PLESK_VHOSTS_DIR=/var/www/vhosts/wegz.org/subdomains
MASTER_FRONTEND_DIR=/var/www/vhosts/wegz.org/master-builds/frontend-latest
MASTER_BACKEND_DIR=/var/www/vhosts/wegz.org/master-builds/backend-latest
PLESK_SYSTEM_USER=wegz_user

# ===== Plesk MongoDB (tenant databases) =====
# كل عميل بيتعمله database منفصلة على MongoDB الموجود على سيرفر Plesk.
# لازم نفس الـ URI ده يتكتب في .env بتاع العميل — الكود بيعمل ده تلقائي.
PLESK_MONGO_URI=mongodb://127.0.0.1:32768
PLESK_MONGO_USER=
PLESK_MONGO_PASS=
TENANT_DB_PREFIX=sc_

# legacy (مش مستخدم — للتوافق فقط)
# TENANT_MONGO_URI=
MONGO_TENANT_USER=admin
MONGO_TENANT_PASS=ChangeMe@123

SUPER_SYSTEGO_URL=https://superback.wegz.org
SUPER_FRONTEND_URL=https://super.wegz.org

VERSION_UPDATER_URL=https://updater.wegz.org
VERSION_UPDATER_API_KEY=change_me

# ===== SSL =====
SSL_ADMIN_EMAIL=admin@wegz.org

# ===== Finance / Reports =====
CURRENCY=EGP
TIMEZONE=Africa/Cairo
INVOICE_PREFIX=WEGZ
